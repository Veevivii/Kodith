# Copy to .env.local for `vercel dev`. Never commit the real values.
#
# DATABASE_URL / DATABASE_URL_UNPOOLED are injected automatically once the
# Neon integration is added in the Vercel dashboard (Storage -> Browse
# Marketplace -> Neon). Fill them in here only for local development.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Injected automatically once Vercel Blob storage is enabled in the dashboard.
BLOB_READ_WRITE_TOKEN=

# A random 32+ character string. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Secret salt for member card IDs. hex_id = sha256(name + email + this),
# so without it the IDs would be computable by anyone who knows a member's
# name and email — the code refuses to mint a card if this is unset.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Treat it as permanent: changing it doesn't alter already-issued cards
# (their IDs are stored), but new cards would be minted from a different
# secret than the old ones.
CARD_ID_SALT=

# Only read by scripts/seed-admin.mjs, and only at the moment you run it.
# Never commit a real password here.
SEED_ADMIN_PASSWORD=
