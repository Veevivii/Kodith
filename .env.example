# Copy to .env.local for `vercel dev`. Never commit the real values.
#
# DATABASE_URL / DATABASE_URL_UNPOOLED are injected automatically once the
# Neon integration is added in the Vercel dashboard (Storage -> Browse
# Marketplace -> Neon). Fill them in here only for local development.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Injected automatically once Vercel Blob storage is enabled in the dashboard.
BLOB_READ_WRITE_TOKEN=

# Optional: emails each new CCE application to the team (see README,
# "Email alerts"). Without it applications are still saved, just not emailed.
RESEND_API_KEY=
# Optional: where alerts go. Defaults to kodith.dev@gmail.com.
NOTIFY_EMAIL=

# A random 32+ character string. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Only read by scripts/seed-admin.mjs, and only at the moment you run it.
# Never commit a real password here.
SEED_ADMIN_PASSWORD=
